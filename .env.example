# ================== فازل‌پرو — نمونهٔ متغیرهای محیطی ==================
# در Railway: Variables → New Variable (مقادیر واقعی را اینجا ننویسید؛ این فایل فقط نمونه است)

# --- ضروری ---
BOT_TOKEN=            # توکن ربات بله (از @BotFather بله)
ADMIN_ID=             # شناسهٔ عددی سوپر ادمین — مثلاً 123456789
DB_PATH=/data/bot_data.db   # دیتابیس روی Volume (Mount Path = /data)

# --- اختیاری ---
# PROVIDER_TOKEN=WALLET-xxxx          # توکن درگاه پرداخت بله — خالی = خرید VIP غیرفعال
# WEBAPP_URL=https://your-app.up.railway.app   # خالی = خودکار از RAILWAY_PUBLIC_DOMAIN
# WEBHOOK_URL=                        # خالی = polling
# WEBHOOK_SECRET=
# MINIAPP_DEMO=off                    # auto | on | off (در production خاموش)
# BOT_USERNAME=                       # خالی = خودکار از getMe
