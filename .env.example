# ================== فازل‌پرو — نمونهٔ متغیرهای محیطی ==================
# در Railway: Variables → Raw Editor ← کل این بلوک را پیست کنید (یا از README بخوانید)
# مقادیر واقعی را در ریپو ننویسید؛ فقط در Variables.

# --- ضروری ---
BOT_TOKEN=                    # توکن ربات بله (از @BotFather بله)
ADMIN_ID=                     # شناسهٔ عددی سوپر ادمین — مثلاً 123456789
DB_PATH=/data/bot_data.db     # «مسیر کامل فایل» روی Volume (Mount Path=/data)

# --- دامنه و مینی‌اپ ---
WEBAPP_URL=                   # خالی = خودکار از RAILWAY_PUBLIC_DOMAIN
PROVIDER_TOKEN=               # توکن درگاه بله (WALLET-...) — خالی = خرید VIP غیرفعال
BOT_USERNAME=                 # خالی = خودکار از getMe
MINIAPP_DEMO=off              # auto | on | off
REQUIRED_CHANNELS=            # کانال‌های اجباری با کاما — خالی = هیچ
FORCE_JOIN_ENABLED=1
SUPPORT_NOTIFY_ADMIN=1
RATE_LIMIT_PER_MIN=120        # سقف درخواست مینی‌اپ برای هر کاربر
INITDATA_MAX_AGE=43200       # v5.3: اعتبار initData (ثانیه) — ۱۲ ساعت
AVATAR_DIR=/data/avatars

# --- وبهوک (پیشنهادی) — هر دو پر = وبهوک، خالی = polling ---
# WEBHOOK_URL باید دامنهٔ HTTPS سرویس باشد، بدون / انتهایی و بدون /bale/webhook
WEBHOOK_URL=
WEBHOOK_SECRET=               # python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_WORKERS=4             # ۲ تا ۴

# --- v5.1: ارسال و محدودیت بله (پیش‌فرض‌ها زیر سقف پایهٔ ۳ پیام/ثانیه) ---
SEND_GATE_RATE_PER_SEC=2.0    # نرخ کل پیام‌سازها
SEND_GATE_BURST=3             # ظرف لحظه‌ای
SEND_BULK_RATE_PER_SEC=1.0    # سقف لِین پخش همگانی (هرگز توکنِ پاسخ کاربر را نمی‌خورد)
SEND_GATE_EDIT_RATE_PER_SEC=4 # ادیت/حذف/تایپینگ
SEND_GATE_EDIT_BURST=4
SEND_GATE_PER_CHAT_SEC=1.0    # حداقل فاصلهٔ دو پیام جدید به یک چت
SEND_INLINE_MAX_WAIT=10       # بودجهٔ انتظار پاسخ تعاملی (ثانیه) — بعد از آن «رد سریع»
SEND_BULK_MAX_WAIT=600        # بودجهٔ انتظار لِین پخش (ثانیه)
SEND_READ_MAX_WAIT=6          # بودجهٔ انتظار متدهای خواندنی در ۴۲۹
SEND_429_MAX_RETRIES=4
SEND_429_DEFAULT_WAIT=3
SEND_429_MAX_PAUSE=120        # سقف توقف سراسری پس از یک ۴۲۹
SEND_GATE_429_COOLDOWN=60     # طول پنجرهٔ سردی
SEND_GATE_429_FACTOR=0.75     # ضریب نرخ در هر پنجرهٔ سردی
SEND_GATE_MIN_FACTOR=0.5      # کف نرخ (۵۰٪ پایه)
SEND_GATE_RECOVERY_SEC=30
SEND_GATE_RECOVERY_STEP=0.1
SEND_STATS_LOG_SEC=300        # لاگ آمار ارسال

# --- نخ‌ها و پخش همگانی ---
BOT_WORKER_THREADS=4          # نخ‌های هندلر telebot
BROADCAST_WORKERS=2           # worker های پخش (سقف ۲ اعمال می‌شود)
BROADCAST_DELAY_SEC=0.35

# --- v5.1: گارد حافظه (پلن ۵۱۲MB) ---
MEM_CHECK_SEC=120
MEM_SOFT_MB=320               # عبور از این حد → پاک‌سازی کش‌ها + malloc_trim
MEM_HARD_MB=440               # دو بار عبور پی‌درپی → ری‌استارت محترمانه (۰ = خاموش)
MEM_TRACE=0                   # ۱ = چاپ ۵ منبع بزرگ حافظه در هر گزارش

# --- v5.3: تشخیص/دیباگ (همه پیش‌فرض خاموش) ---
STARTUP_DIAGNOSTICS=0         # ۱ = متریک‌های تحلیلی + خودآزمایی لیدربورد/چرخ در استارت (RAM/CPU بیشتر)
ACCESS_LOG=0                  # ۱ = لاگ همهٔ درخواست‌های HTTP (پیش‌فرض: فقط خطا و درخواست کند)
ALLOW_AUTO_ADMIN=0            # فقط محیط تست: ۱ + ADMIN_ID خالی = اولین /start ادمین می‌شود
# FORWARDED_ALLOW_IPS=*       # IPهای پراکسی مورد اعتماد برای uvicorn

# --- v5.4: داشبورد ادمین — آمار سرور و هزینهٔ Railway (همه اختیاری) ---
# بدون توکن: رم/CPU داخل کانتینر اندازه‌گیری و هزینه با نرخ عمومی Railway تخمین زده می‌شود.
# با توکن: اعداد دقیق خود Railway (همان نمودار داشبوردش) + ترافیک خروجی.
# ساخت توکن: Railway → Account Settings → Tokens (یا Project Settings → Tokens برای توکن پروژه)
# RAILWAY_API_TOKEN=          # توکن حساب/ورک‌اسپیس (هدر Authorization: Bearer)
# RAILWAY_PROJECT_TOKEN=      # یا توکن پروژه (هدر Project-Access-Token)
# RAILWAY_PROJECT_ID / RAILWAY_SERVICE_ID / RAILWAY_ENVIRONMENT_ID را خود Railway تزریق می‌کند.
# RAILWAY_PLAN_CREDIT_USD=5   # اعتبار ماهانهٔ پلن برای نمایش «از اعتبار» (Hobby=5)
# RAILWAY_PRICE_RAM_GB_MONTH=10  RAILWAY_PRICE_CPU_MONTH=20  RAILWAY_PRICE_VOLUME_GB_MONTH=0.15  RAILWAY_PRICE_EGRESS_GB=0.05
# SERVER_MEMORY_MB=512        # سقف رم برای نوار درصد (پیش‌فرض: از cgroup، وگرنه ۵۱۲)
# SERVER_SAMPLE_SEC=60        # فاصلهٔ نمونه‌برداری رم/CPU
# RAILWAY_REFRESH_SEC=300     # فاصلهٔ کوئری API رسمی Railway

# --- اقتصاد و بازی ---
XP_PER_SNOOP=5
FREE_MAX_TRAPS=1
VIP_MAX_TRAPS=10
TOMAN_TO_RIAL=10
# VIP_PLANS=                  # JSON دلخواه پلن‌های VIP — خالی = پیش‌فرض
# CSP=                        # خالی = پیش‌فرض امن مینی‌اپ بله
