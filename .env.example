# ================== فازل‌پرو — نمونهٔ متغیرهای محیطی ==================
# در Railway: Variables → New Variable (مقادیر واقعی را اینجا ننویسید؛ این فایل فقط نمونه است)

# --- ضروری ---
BOT_TOKEN=            # توکن ربات بله (از @BotFather بله)
ADMIN_ID=             # شناسهٔ عددی سوپر ادمین — مثلاً 123456789
DB_PATH=/data/bot_data.db   # دیتابیس روی Volume (Mount Path=/data) — «مسیر کامل فایل» باشد؛ DB_PATH=/data (فقط پوشه) غلط است و v5.0.1 آن را خودکار اصلاح می‌کند

# --- اختیاری ---
# PROVIDER_TOKEN=WALLET-xxxx          # توکن درگاه پرداخت بله — خالی = خرید VIP غیرفعال
# WEBAPP_URL=https://your-app.up.railway.app   # خالی = خودکار از RAILWAY_PUBLIC_DOMAIN
# WEBHOOK_URL=                        # خالی = polling
# WEBHOOK_SECRET=
# WEBHOOK_WORKERS=4                   # v5.0: worker های پردازش وب‌هوک (۲ تا ۴ — صف داخلی)
# MINIAPP_DEMO=off                    # auto | on | off (در production خاموش)
# BOT_USERNAME=                       # خالی = خودکار از getMe

# --- v5.0: گیت سراسری ارسال (bot_sender) — پیش‌فرض‌ها امن‌اند، تنظیم لازم نیست ---
# طبق اعلان بله نرخ پایه ۳ پیام/ثانیه است؛ پیش‌فرض ۲.۵/ثانیه با burst=۳ زیر سقف می‌ماند.
# SEND_GATE_RATE_PER_SEC=2.5          # نرخ سراسری پیام‌سازها (sendMessage و ...)
# SEND_GATE_BURST=3                   # ظرف لحظه‌ای گیت سراسری
# SEND_GATE_EDIT_RATE_PER_SEC=10      # نرخ ادیت/حذف (پیام جدید نمی‌سازند)
# SEND_GATE_PER_CHAT_SEC=0.75         # حداقل فاصلهٔ دو ارسال پیام به یک چت
# SEND_429_MAX_RETRIES=5              # تلاش مجدد خودکار در خطای 429 (با retry_after بله)
# SEND_429_DEFAULT_WAIT=3             # صبر پیش‌فرض اگر بله retry_after نفرستاد
# SEND_GATE_429_COOLDOWN=120          # مدت سردشدن گیت پس از 429 (نرخ نصف می‌شود)
# SEND_STATS_LOG_SEC=300              # بازهٔ لاگ آمار ارسال
